{% comment %}
  ORJN Concierge — App Embed Block
  This loads the chatbot widget into the storefront.
  Activate it via: Online Store → Themes → Customize → App embeds
{% endcomment %}

<div id="orjn-concierge-root"></div>

<script>
  window.__ORJN_CONFIG__ = {
    apiUrl: {{ block.settings.api_url | json }},
    shopDomain: {{ shop.domain | json }},
    whatsappNumber: {{ block.settings.whatsapp_number | json }},
    whatsappEnabled: {{ block.settings.whatsapp_enabled | json }},
    nudgeEnabled: {{ block.settings.nudge_enabled | json }}
  };
</script>

<script src="{{ block.settings.widget_url | escape }}" defer></script>

{% schema %}
{
  "name": "ORJN Concierge",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "API URL",
      "info": "The URL of your ORJN Concierge backend (e.g. https://your-server.com)",
      "default": "https://chatbot-production-e827.up.railway.app"
    },
    {
      "type": "text",
      "id": "widget_url",
      "label": "Widget JS URL",
      "info": "The URL of the compiled widget JavaScript file",
      "default": "https://chatbot-production-e827.up.railway.app/orjn-concierge.js"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "info": "International format without spaces, e.g. 96170123456",
      "default": "96179081625"
    },
    {
      "type": "checkbox",
      "id": "whatsapp_enabled",
      "label": "Show WhatsApp actions",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "nudge_enabled",
      "label": "Show chat attention prompt",
      "default": true
    }
  ]
}
{% endschema %}
